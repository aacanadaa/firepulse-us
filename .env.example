# ---------------------------------------------------------------------------
# FirePulse US: environment
# Copy to .env and adjust. The demo needs nothing; live data needs
# DATA_MODE=live and a FIRMS_MAP_KEY.
# ---------------------------------------------------------------------------

# API
PORT=8790
HOST=0.0.0.0
LOG_LEVEL=info
DATA_MODE=simulation            # simulation | live | hybrid (docker compose defaults to live)
CORS_ORIGIN=*

# Web (inlined at build time)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8790

# Storage: omit DATABASE_URL to run the in-memory dev store
# DATABASE_URL=postgres://firepulse:firepulse@127.0.0.1:5432/firepulse
# REDIS_URL=redis://127.0.0.1:6379

# Public APIs (NWS, Open-Meteo) ask callers to identify themselves.
FIREPULSE_USER_AGENT="FirePulse/1.0 (you@example.com)"

# Fusion tuning. Evidence windows are per source (30 h VIIRS/MODIS, 2 h GOES,
# 60-90 min dispatch/crowd); see windowMin in packages/protocol/src/confidence.ts.
FUSION_RADIUS_KM=2
# FUSION_INTERVAL_MS=4000       # default 4000 in simulation, 60000 in live (live also fuses on arrival)
FUSION_HULL_BUFFER_M=220
FUSION_TTL_MIN=45               # grace after a cluster's evidence ages out
FUSION_MATCH_KM=3
PUBLISH_MIN_CONFIDENCE=8

# Retention / transport
HOTSPOT_RETENTION_HOURS=24
SNAPSHOT_HOTSPOT_BUDGET=10000
SNAPSHOT_INCIDENT_BUDGET=1500
MAX_WS_CLIENTS=5000

# Live feeds (only used when DATA_MODE=live|hybrid)
# FIRMS_MAP_KEY=your_nasa_firms_map_key     # free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# FIRMS_BBOX=-126,23,-66,50
# FIRMS_DAYS=2                              # minimum day range per poll
# WFIGS_PERIMETERS_URL=https://services3.arcgis.com/T4QMspbfLg3qTGWY/arcgis/rest/services/WFIGS_Interagency_Perimeters_Current/FeatureServer/0
# WFIGS_INCIDENTS_URL=https://services3.arcgis.com/T4QMspbfLg3qTGWY/arcgis/rest/services/WFIGS_Incident_Locations_Current/FeatureServer/0
# NWS_URL=https://api.weather.gov/alerts/active?status=actual&event=...   # override the followed events

# Tier-1 push webhooks (PulsePoint-shaped CAD, crowd sightings)
# INGEST_WEBHOOK_SECRET=change-me

# Next-day spread forecasts (experimental). Needs the FireSight ONNX model and
# CONUS static layers; see README "Next-day spread forecasts". If the files are
# missing, spread switches off with one warning and everything else still runs.
# SPREAD_ENABLED=true
# SPREAD_MODEL_PATH=apps/api/assets/spread/firesight-best.onnx   # firesight-model.json must sit next to it
# SPREAD_STATIC_DIR=apps/api/assets/spread/static_conus
# SPREAD_ASSETS_URL=https://github.com/<you>/<repo>/releases/download/<tag>   # optional: download missing files
# SPREAD_MIN_CONFIDENCE=40        # estimates below this get no forecast
# SPREAD_MAX_CONCURRENT=2
# SPREAD_USER_AGENT="FirePulse/1.0 (you@example.com)"   # NWS asks for a contact

# Accounts and alerts
# WEB_ORIGIN=http://localhost:3000            # where the web app lives (sign-in redirects, cookie security)
# SESSION_SECRET=...                          # set when running more than one API instance
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com   # optional "Sign in with Google"
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:8790/api/v1/auth/google/callback   # must match the Google client
# Web Push key pair: npx web-push generate-vapid-keys (changing it drops every browser subscription)
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com        # push services contact this address about problems

# Web: account routes are proxied through the web origin to this API address
# API_INTERNAL_URL=http://127.0.0.1:8790

# Air quality (EPA AirNow; free key from docs.airnowapi.org)
# AIRNOW_API_KEY=...

# Production hardening
# TRUST_PROXY=1                 # proxies in front of the API: a hop count, a list of addresses, or true/false
# RATE_LIMIT_PER_MINUTE=600     # per client, across the HTTP API
# METRICS_TOKEN=...             # bearer token for /metrics (off in production without one)
# OPS_WEBHOOK_URL=...           # Slack/Discord-style webhook for failing or stale feeds
# HEAT_MASK_PATH=apps/api/data/heat-mask.json   # rebuild monthly: pnpm --filter @firepulse/api heat-mask:build

# Web: legal pages
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
# NEXT_PUBLIC_LEGAL_REVIEWED=true   # hides the "draft" note on Privacy and Terms once you've reviewed them
