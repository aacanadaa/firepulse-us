{
  "name": "firepulse-us",
  "version": "1.0.0",
  "private": true,
  "description": "FirePulse US: real-time wildfire fusion tracker (early signals + official ground truth)",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @firepulse/api dev & pnpm --filter @firepulse/web dev",
    "dev:api": "pnpm --filter @firepulse/api dev",
    "dev:web": "pnpm --filter @firepulse/web dev",
    "build": "pnpm --filter @firepulse/protocol build && pnpm --filter @firepulse/api build && pnpm --filter @firepulse/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @firepulse/api test",
    "db:migrate": "pnpm --filter @firepulse/api db:migrate",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/seed/dev_seed.sql",
    "basemap:build": "node scripts/build-basemap.mjs",
    "spread:assets": "pnpm --filter @firepulse/api exec tsx src/spread/assets.ts"
  },
  "devDependencies": {
    "geojson-vt": "^4.0.2",
    "pmtiles": "^4.3.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.3",
    "vt-pbf": "^3.1.3"
  }
}
