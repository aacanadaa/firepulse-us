# syntax=docker/dockerfile:1
# Lean API image for small VMs (1 GB RAM / 10 GB disk).
# Skips devDependencies and install scripts. onnxruntime-node ships its
# linux/x64 CPU binaries in the package, so spread forecasts work without its
# postinstall. Model assets are downloaded at startup from SPREAD_ASSETS_URL.
FROM node:22-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@12.11.2 --activate
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/protocol/package.json packages/protocol/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile --filter @firepulse/protocol --filter @firepulse/api --ignore-scripts \
 && pnpm --filter @firepulse/protocol build \
 && pnpm --filter @firepulse/api build \
 && pnpm install --prod --frozen-lockfile --filter @firepulse/protocol --filter @firepulse/api --ignore-scripts \
 && rm -rf /pnpm/store /root/.local/share/pnpm /root/.cache /tmp/*

FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/package.json /app/pnpm-workspace.yaml ./
COPY db ./db
EXPOSE 8790
CMD ["node", "apps/api/dist/index.js"]
